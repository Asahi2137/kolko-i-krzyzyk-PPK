<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="zad2.MainWindow"
        Title="zad2">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="TurnText" Text="Tura gracza: X" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <UniformGrid x:Name="BoardGrid" Rows="3" Columns="3" Width="300" Height="300"/>
        <Button Content="Zacznij od nowa" Click="Restart_Click" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        <Button Content="tryby gry" Click="ToggleMode_Click" HorizontalAlignment="Center" Margin="0,20,0,0"/>
    </StackPanel>
</Window>